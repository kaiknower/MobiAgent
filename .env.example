# Copy to .env, fill in the required API settings, then source it with export enabled.
# GPT API: planning, visual reflection, frame inference and skill naming.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Optional model overrides; blank values use OPENAI_MODEL.
MOBIAGENT_PLANNER_MODEL=
MOBIAGENT_JUDGE_MODEL=
MOBIAGENT_FRAME_MODEL=
MOBIAGENT_NAMING_MODEL=
# Gemini: used for BEHAVIOR video-based skill discovery.
GEMINI_API_KEY=
# Optional alternative provider for BEHAVIOR video discovery.
DASHSCOPE_API_KEY=
MOBIAGENT_SEGMENTS_DIR=data/segments
MOBIAGENT_ASSETS_DIR=assets
MOBIAGENT_CHECKPOINT_DIR=checkpoints
MOBIAGENT_ROBOCASA_RECIPE=configs/robocasa/data.json
# Optional BEHAVIOR packed-frame cache; set absolute paths when using another location.
OPENPI_SKILL_SEGMENT_VIDEO_ROOT=
OPENPI_SKILL_SEGMENT_PACKED_CACHE_ROOT=
CLAW_PROMPT_STYLE=skill_only
