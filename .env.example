# Copy to .env, fill in the required API settings, then source it with export enabled.
# Azure OpenAI: required for planning, visual reflection and skill naming.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Gemini: used for BEHAVIOR video-based skill discovery.
GEMINI_API_KEY=
# Optional alternative provider for BEHAVIOR video discovery.
DASHSCOPE_API_KEY=
MOBIAGENT_SEGMENTS_DIR=data/segments
MOBIAGENT_ASSETS_DIR=assets
MOBIAGENT_CHECKPOINT_DIR=checkpoints
MOBIAGENT_ROBOCASA_RECIPE=configs/robocasa/data.json
CLAW_PROMPT_STYLE=skill_only
